{
  "i18n-ally.localesPaths": ["i18n/locales"],
  "i18n-ally.keystyle": "nested",

  // Override whatever the outer shell exported. Prisma refuses non-`file:`
  // DATABASE_URLs (see server/db/prisma.ts), and a stray postgres URL
  // exported from $PROFILE / Windows user vars would otherwise leak into
  // `npm run dev` inside VSCode. The `.env` file has the same value —
  // this is belt-and-suspenders so the wrong value can never win here.
  "terminal.integrated.env.windows": {
    "DATABASE_URL": "file:./alert.sqlite"
  }
}
