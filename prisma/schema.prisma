// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


model AlertTable {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  input       String?                        // Source enum value (e.g. "GitHub Push")
  status      String   @default("draft")    // draft | inactive | active
  triggerType String?                        // Trigger enum value (e.g. "Webhook")
  token         String?  @unique @default(uuid())
  triggerParams Json?                        // source-specific config; _-prefixed keys are runtime state
  // ??? guardar atributo aparte con la frecuencia o hora de polling
  createdAt     DateTime @default(now())
  bundles       Bundle[]
}

// A bundle is one output of an alert: a set of discussions + a formatting.
// One alert can have many bundles (same event, different audiences/formats).
model Bundle {
  id              Int        @id @default(autoincrement())
  name            String?
  alertId         Int
  alert           AlertTable @relation(fields: [alertId], references: [id], onDelete: Cascade)
  discussion_list BigInt[]
  formating       String     @default("Unformatted")
  custom_script   String?
  createdAt       DateTime   @default(now())
}

// One row per input source — stores only the last successful webhook payload.
// source is the primary key so upsert is a single operation.
model LastSourcePayload {
  source    String   @id   // e.g. "GitHub Push"
  payload   Json
  updatedAt DateTime @updatedAt
}
