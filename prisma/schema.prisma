generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AlertTable {
  id                Int                @id @default(autoincrement())
  title             String
  description       String?
  input             String?
  triggerType       String?
  status            String             @default("draft")
  token             String?            @unique @default(uuid())
  createdAt         DateTime           @default(now())
  triggerParams     Json?
  bundles           Bundle[]
  lastPayload       LastAlertPayload?
  lastFailedPayload LastFailedPayload?
}

model Bundle {
  id              Int        @id @default(autoincrement())
  name            String?
  alertId         Int
  discussion_list BigInt[]
  formating       String     @default("Unformatted")
  custom_script   String?
  createdAt       DateTime   @default(now())
  alert           AlertTable @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model LastAlertPayload {
  alertId    Int        @id
  payload    Json
  receivedAt DateTime   @updatedAt
  alert      AlertTable @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model LastFailedPayload {
  alertId  Int        @id
  raw      String?
  parsed   Json?
  error    String
  stage    String?
  failedAt DateTime   @updatedAt
  alert    AlertTable @relation(fields: [alertId], references: [id], onDelete: Cascade)
}
