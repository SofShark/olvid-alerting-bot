// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


// Auth — one User row per person able to log in. The first user created
// on a fresh deploy goes through /setup and gets role="admin"; further
// users are created by an admin via /users (invite-by-email flow) and
// default to role="user". `passwordHash` is null until the user completes
// their password setup (invite acceptance or first-run setup form).
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String?
  name          String?
  role          String    @default("user") // "admin" | "user"
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tokens        VerificationToken[]
}

// Single-use tokens for invite / email verification / password reset.
// We store sha256(rawToken) — the raw token exists only inside the email
// we send. `usedAt` implements one-shot semantics; `expiresAt` bounds TTL.
model VerificationToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String    // "invite" | "email_verify" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model AlertTable {
  id                Int                @id @default(autoincrement())
  title             String
  description       String?
  // `input` stores the Source: "Polling Source" | "Webhook Source". It IS
  // the alert's type discriminator — no separate column, no nested copy.
  input             String?
  status            String             @default("draft")
  // Kept top-level (not inside alertParams) so the webhook handler can
  // `findUnique` by token without hitting JSON path operators.
  token             String?            @unique @default(uuid())
  createdAt         DateTime           @default(now())
  // Type-specific config only. The source is NOT duplicated here — see `input`.
  //   Polling Source → { url, format, schedule, condition, triggerMode?,
  //                      _baseline?, _lastHash?, _lastFired?, _lastPolledAt? }
  //     - `schedule` is a cron string ("*/5 * * * *"); see shared/polling/schedule.ts.
  //   Webhook Source → {}
  alertParams       Json?

  bundles           Bundle[]
  lastPayload       LastAlertPayload?
  lastFailedPayload LastFailedPayload?
  logs              AlertLog[]
}

model Bundle {
  id              Int        @id @default(autoincrement())
  name            String?
  alertId         Int
  
  formating       String     @default("Unformatted")
  custom_script   String?
  createdAt       DateTime   @default(now())

  alert           AlertTable     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  outputs         BundleOutput[]
}

model BundleOutput{
  id        Int      @id @default(autoincrement())
  bundleId  Int
  type      String   // "olvid" (único tipo por ahora). Futuro: "email", "slack", "discord".
  params    Json     // Shape depende de `type`. Ver §Contrato de `params` por tipo.
  createdAt DateTime @default(now())

  bundle    Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId])
}

model LastAlertPayload {
  alertId    Int        @id
  payload    Json
  receivedAt DateTime   @updatedAt
  alert      AlertTable @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model LastFailedPayload {
  alertId  Int        @id
  raw      String?
  parsed   Json?
  error    String
  stage    String?
  failedAt DateTime   @updatedAt
  alert    AlertTable @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

/// One-to-many events log per alert. Every poll (success or failure) inserts
/// one row; the heartbeat's failure branches populate `error` with a
/// human-readable message. The 200-row cap per alertId is enforced in
/// `alertLogRepository.insert` — no DB trigger needed.
model AlertLog {
  id        Int        @id @default(autoincrement())
  alertId   Int
  status    String     // "success" | "warning" | "error"
  error     String?    // populated only for warning / error rows
  createdAt DateTime   @default(now())
  alert     AlertTable @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt(sort: Desc)])
}
