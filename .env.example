# Copy to `.env` and fill in real values. `.env` is gitignored.
# The Docker Compose `nuxt_app` service loads this file via `env_file`.

# Database — embedded SQLite file. Created on first boot by `prisma db push`.
# In compose the container writes to /data/alerting.db (bind-mounted from ./data).
# For local `npm run dev` outside compose, use `file:./dev.db` instead.
DATABASE_URL=file:/data/alerting.db

# Olvid daemon inside compose.
OLVID_DAEMON_URL=http://daemon:50051
OLVID_CLIENT_KEY=

# SMTP — used by server/clients/mailClient.ts for the "mail" bundle-output.
# Defaults below match MailPace (https://docs.mailpace.com/integrations/smtp).
# SMTP_FROM must be a verified sender on the provider or delivery is rejected.
SMTP_HOST=smtp.mailpace.com
SMTP_PORT=587
# MailPace's SMTP wants your Domain SMTP Token as BOTH user and password.
SMTP_USER=<your-mailpace-server-token>
SMTP_PASSWORD=<your-mailpace-server-token>
SMTP_FROM=Alerting Bot <alerts@yourdomain.com>

# Auth — nuxt-auth-utils signs the session cookie with this secret. Must
# be at least 32 characters. Generate with e.g. `openssl rand -base64 48`.
NUXT_SESSION_PASSWORD=

# First-run bootstrap secret. Required for /setup to succeed — the
# operator supplies this same value in the setup form to prove they
# control the deploy. Without it the initial admin account cannot be
# created, so a stranger who reaches the /setup URL first can't grab
# admin. Generate with e.g. `openssl rand -base64 32`.
ADMIN_KEY=

# Origin used in outgoing invite / email-verification links, e.g.
# https://alerts.example.com. If unset, the server falls back to the
# incoming request's host header (fine for dev, unreliable behind proxies).
NUXT_PUBLIC_BASE_URL=
