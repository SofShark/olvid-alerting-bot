# Copy to `.env` and fill in real values. `.env` is gitignored.
# The Docker Compose `nuxt_app` service loads this file via `env_file`.

# Database — the running Postgres container inside compose.
DATABASE_URL=postgresql://postgres@postgres_db:5432/mi_base_datos?schema=public

# Olvid daemon inside compose.
OLVID_DAEMON_URL=http://daemon:50051
OLVID_CLIENT_KEY=

# SMTP — used by server/clients/mailClient.ts for the "mail" bundle-output.
# Defaults below match MailPace (https://docs.mailpace.com/integrations/smtp).
# SMTP_FROM must be a verified sender on the provider or delivery is rejected.
SMTP_HOST=smtp.mailpace.com
SMTP_PORT=587
# MailPace's SMTP wants your Domain SMTP Token as BOTH user and password.
SMTP_USER=<your-mailpace-server-token>
SMTP_PASSWORD=<your-mailpace-server-token>
SMTP_FROM=Alerting Bot <alerts@yourdomain.com>
